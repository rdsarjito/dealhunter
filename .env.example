# =============================================================
# DealHunter Production Environment Variables (Server Lenovo)
# =============================================================

# Database Configuration (PostgreSQL)
DB_USER=dealhunter
DB_PASSWORD=dealhunter_secret_pass
DB_NAME=dealhunter
DB_PORT=5432

# Telegram Bot Token (Dapatkan dari @BotFather)
TELEGRAM_BOT_TOKEN=

# Frontend API Target (Ganti dengan IP / Domain Server Lenovo Anda)
# Contoh: http://192.168.1.100:8080/api/v1 atau http://lenovo-server.local:8080/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
